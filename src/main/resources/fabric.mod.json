{
  "schemaVersion": 1,
  "id": "creativespectatefix",
  "version": "${version}",
  "name": "CreativeSpectateFix",
  "description": "Client-side camera and first-person compatibility for TrainCarts simulated platform views.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.sylvarion.creativespectatefix.client.CreativeSpectateFixDataGenerator"
    ],
    "client": [
      "org.sylvarion.creativespectatefix.client.CreativeSpectateFixClient"
    ],
    "main": [
      "org.sylvarion.creativespectatefix.CreativeSpectateFix"
    ]
  },
  "mixins": [
    "creativespectatefix.mixins.json",
    {
      "config": "creativespectatefix.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
